# oracle-hunter configuration template
# Copy to config.env next to the binary (keep permissions 0600).
# Only the four credentials + region are required — everything marked
# "auto" is discovered from the OCI API on the first run.

# ---- required: OCI credentials ----
# Console → Profile → Tenancy / User, and the API key fingerprint.
OCI_TENANCY_OCID=ocid1.tenancy.oc1..your_tenancy
OCI_USER_OCID=ocid1.user.oc1..your_user
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
OCI_REGION=ap-batam-1
OCI_PRIVATE_KEY_PATH=oci_api_key.pem

# ---- instance target (empty = auto-discover) ----
AD_NAME=
SUBNET_OCID=
IMAGE_OCID=
OS_NAME=Canonical Ubuntu
OS_VERSION=24.04
SHAPE=VM.Standard.A1.Flex
# 0 = automatic: largest allocation your tenancy still allows
OCPUS=0
MEMORY_GB=0
BOOT_VOLUME_SIZE=50
DISPLAY_NAME=vm-a1
ASSIGN_PUBLIC_IP=true
# Your SSH public key — strongly recommended, otherwise you cannot log in
SSH_AUTHORIZED_KEYS=

# ---- hunting behavior ----
INTERVAL_BASE_SECS=120
INTERVAL_JITTER_SECS=0
BACKOFF_FACTOR=1.5
BACKOFF_MAX_SECS=600
MAX_INSTANCES=1
BATTERY_MIN_PCT=15
WIFI_ONLY=true

# ---- WebUI ----
WEBUI_PORT=8080
# Generated on first run — this is your WebUI login token
AUTH_TOKEN=

# ---- notifications (optional) ----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# minutes between summary messages (0 = off, minimum 15)
TELEGRAM_SUMMARY_INTERVAL_MINS=0
TELEGRAM_FOUND_TEMPLATE=Oracle A1 secured!\nName: {name}\nIP: {ip}\nLogin: ssh ubuntu@{ip}\nAttempts: {sum}\nOCID: {ocid}\nTime: {time}
TELEGRAM_SUMMARY_TEMPLATE=Oracle A1 Hunter summary\nAttempts: {sum} | No capacity: {capacity} | 429: {rate_limited} | Errors: {errors}\nUptime: {uptime} | Battery: {battery}%\nRegion: {region} | Target: {target}\nTime: {time}
